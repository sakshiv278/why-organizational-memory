# --- LLM (local, CPU) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# 3B is the CPU-friendly default (~5-10 tok/s). Use qwen2.5:7b-instruct if your machine has 16GB+ RAM and you accept ~2-3x slower answers.
LLM_MODEL=qwen2.5:3b-instruct
LLM_FAST_MODEL=qwen2.5:3b-instruct
LLM_NUM_CTX=4096
# --- Retrieval ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
# --- Storage ---
WHY_DB=data/why.sqlite
